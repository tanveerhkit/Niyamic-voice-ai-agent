# Relay — planned real-audio configuration
#
# The current demo runs entirely in mock mode and reads none of these values.
# They are the shape of the production integration described in README.md.

# LiveKit (transport)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional if the browser must use a different URL than the server:
# NEXT_PUBLIC_LIVEKIT_URL=

# Azure Speech (STT + TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure OpenAI (reasoning + tool calls)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# CRM (customer history + notes)
CRM_BASE_URL=
CRM_API_TOKEN=

# SIP trunk (optional telephony)
SIP_TRUNK_URI=
SIP_USERNAME=
SIP_PASSWORD=

# Outbound webhooks (optional)
WEBHOOK_SECRET=
