# Niyamic Echo — environment
#
# The Python backend (backend/api.py and backend/agent.py) reads this file from the
# repository root as .env.local. Provider keys never reach the browser: the
# frontend only needs NEXT_PUBLIC_VOICE_API_URL.

# Frontend -> backend
NEXT_PUBLIC_VOICE_API_URL=http://localhost:8000

# LiveKit — realtime voice transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Azure OpenAI — replies and tool calls. Use ONE of the two forms.
# a) v1 endpoint (Azure AI Foundry / OpenAI-compatible): base URL ending in /openai/v1 + model name
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# b) classic Azure OpenAI: resource endpoint + deployment name + API version
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_TEMPERATURE=0.3   # "none" to use the model default

# Deepgram — speech-to-text
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# en-IN (default) is most accurate for English callers. "multi" adds English/Hindi
# code-switching but can mis-detect short greetings as other languages.
# DEEPGRAM_LANGUAGE=en-IN

# Smallest AI — text-to-speech
SMALLEST_API_KEY=
# SMALLEST_MODEL=lightning_v3.1_pro
# SMALLEST_VOICE_ID=
# SMALLEST_LANGUAGE=en

# Optional
# DATA_DIR=            # uploads and search index (default: backend/storage)
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=https://app.example.com   # extra allowed frontend origins; localhost is always allowed
